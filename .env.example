# Every setting NextUp reads. Real values live in the Vercel project's environment variables;
# `vercel env pull .env.local` copies the development ones here (git-ignored).

# Tiger Data. The API uses TIGER_POOLER_URL if set, else the direct URL; migrations use the direct URL.
# Notify timings and the simulator switch live in Tiger's `settings` table, not here.
TIGER_POOLER_URL=postgres://tsdbadmin:...@....tsdb.cloud.timescale.com:.../tsdb_transaction?sslmode=require
TIGER_DATABASE_URL=postgres://tsdbadmin:...@....tsdb.cloud.timescale.com:.../tsdb?sslmode=require
# Local development instead of Tiger (docker compose up -d db):
# DATABASE_URL=postgresql://postgres:nextup@localhost:5433/nextup

# Supabase project `nextup`. The VITE_ copies are read by the website at build time.
SUPABASE_URL=https://vmngdkwhasbertcwcbnj.supabase.co
VITE_SUPABASE_URL=https://vmngdkwhasbertcwcbnj.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...                 # server only: sends Realtime messages

# Shared with Supabase Vault (nextup_cron_secret); Supabase Cron sends it to /api/tick.
CRON_SECRET=...

# Not used yet
GEMINI_API_KEY=...
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
