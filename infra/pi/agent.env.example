# /etc/nextup/agent.env on the Pi (chmod 600). Never commit the real file.
# Print a filled-in copy on the laptop with: .venv/bin/python scripts/pi_env.py s1
NEXTUP_API=https://nextup-khaki.vercel.app
NEXTUP_STALL=s1
NEXTUP_DEVICE_TOKEN=paste-this-stall's-token-here
SUPABASE_URL=https://vmngdkwhasbertcwcbnj.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_P2xnJtFjXrysLpYM7yqB0A_EGquy3jN
# HC-SR04 pins (BCM numbers): TRIG on GPIO23, ECHO on GPIO24 through a voltage divider
TRIG_PIN=23
ECHO_PIN=24
# Calibrate per stall: python -m device.nextup_agent.calibrate
PRESENT_MAX_CM=120
HOLD_MAX_CM=15
NEXTUP_DATA_DIR=/var/lib/nextup
# LD2410C radar for presence (the HC-SR04 then only does the hand-hold). Radar TX → GPIO15 (pin 10),
# no voltage divider. Tune with: python -m device.nextup_agent.calibrate --radar
# PRESENCE_SENSOR=ld2410c
# RADAR_MAX_CM=150
# RADAR_MIN_ENERGY=30
# RADAR_MIN_CM=0          # ignore targets closer than this (a flexing plastic cover)
# RADAR_DEBUG=1           # log what the radar sees once a second, for tuning
# ULTRASONIC=off          # radar only, HC-SR04 unplugged: no hand-hold to acknowledge Notify
# FAKE_SENSOR=1           # test without the sensor: type in, out or hold
# Tuning: ENTER_SECONDS=20 LEAVE_SECONDS=30 HOLD_SECONDS=2 RANGE_CM=300 SAMPLE_HZ=10
