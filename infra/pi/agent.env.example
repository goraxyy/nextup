# /etc/nextup/agent.env on the Pi (chmod 600). Never commit the real file.
# Print a filled-in copy on the laptop with: .venv/bin/python scripts/pi_env.py s1
NEXTUP_API=https://nextup-khaki.vercel.app
NEXTUP_STALL=s1
NEXTUP_DEVICE_TOKEN=paste-this-stall's-token-here
SUPABASE_URL=https://vmngdkwhasbertcwcbnj.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_P2xnJtFjXrysLpYM7yqB0A_EGquy3jN
# HC-SR04 pins (BCM numbers): TRIG on GPIO23, ECHO on GPIO24 through a voltage divider
TRIG_PIN=23
ECHO_PIN=24
# Calibrate per stall: python -m device.nextup_agent.calibrate
PRESENT_MAX_CM=120
HOLD_MAX_CM=15
NEXTUP_DATA_DIR=/var/lib/nextup
# LD2410C radar for presence (the HC-SR04 then only does the hand-hold). Radar TX → GPIO15 (pin 10),
# no voltage divider. Tune with: python -m device.nextup_agent.calibrate --radar
# PRESENCE_SENSOR=ld2410c
# RADAR_MAX_CM=150
# RADAR_MIN_ENERGY=30
# RADAR_MIN_CM=0          # ignore targets closer than this (a flexing plastic cover)
# RADAR_DEBUG=1           # log what the radar sees (and the energy at each gate) once a second
# RADAR_GATE_CM=20        # 20 cm distance gates (0-1.8 m) instead of 75 cm; needs radar RX → GPIO14 (pin 8)
# Per-gate sensitivity: calibrate the empty stall with  calibrate --radar-auto, or set by hand:
# RADAR_MOVING_SENS=50,50,40,30,20,15,15,15,15   RADAR_STILL_SENS=0,0,40,40,30,30,20,20,20
# RADAR_NOBODY_SECONDS=5  # how long the radar holds a target after it leaves
# ULTRASONIC=off          # radar only, HC-SR04 unplugged: no hand-hold to acknowledge Notify
# Hand-hold to answer a Hurry: 5 s by default, and only while the pop-up is on the screen.
# HOLD_SECONDS=5
# With the LD2410C radar, a raised hand also counts: a moving target this close and strong.
# RADAR_HOLD=on  RADAR_HOLD_MAX_CM=30  RADAR_HOLD_MIN_ENERGY=50
# Stall screen pages: PAGE_STATUS_SECONDS=10  PAGE_EVENT_SECONDS=8  SCREEN_EVERY_SECONDS=300
# FAKE_SENSOR=1           # test without the sensor: type in, out or hold
# Tuning: ENTER_SECONDS=20 LEAVE_SECONDS=30 RANGE_CM=300 SAMPLE_HZ=10
# Experimental shower music: Spotify Connect on this Pi, lyrics, radar pause/skip (infra/pi/music/README.md)
# MUSIC=spotify-web            # follow the phone's official Spotify app (needs the two lines below)
# SPOTIFY_CLIENT_ID=...        # your Spotify developer app; sign in with scripts/spotify_login.py
# SPOTIFY_TOKEN_FILE=/var/lib/nextup/spotify-token.json
# MUSIC=spotify                # or: go-librespot on the Pi as a Spotify Connect speaker
# MUSIC_NUDGE_EVERY=5          # every 5 songs in a shower the lion asks them to hurry; 0 = never
# MUSIC_SHAMPOO_AFTER=2        # after 2 songs: "Let's shampoo!" and a wave of bubbles; 0 = never
# CELEBRATE_SECONDS=10         # the lion celebrates on the way out (experimental; off unless set)
# GOAL_ASK_SECONDS=15          # "How long will your shower be?" by hold, watch, release (experimental; off unless set)
# GOAL_OPTIONS=5,10,15
# MUSIC_DEVICE_NAME=NextUp Stall 1   # the name to show on the screen (set the same name in config.yml)
